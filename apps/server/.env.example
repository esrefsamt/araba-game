# Pass these through the process environment; the server does not load dotenv files.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
ALLOWED_ORIGINS=https://example-client.com
# Keep false for browser deployments. Explicitly opt in only if origin-less native clients are required.
ALLOW_NO_ORIGIN=false
LOG_LEVEL=info
SESSION_GRACE_MS=15000
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=5000
