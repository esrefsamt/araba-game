{
  "name": "trailer-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @trailer-arena/shared build && concurrently -k -n shared,server,client -c yellow,cyan,magenta \"pnpm --filter @trailer-arena/shared dev\" \"pnpm --filter @trailer-arena/server dev\" \"pnpm --filter @trailer-arena/client dev\"",
    "dev:client": "pnpm --filter @trailer-arena/shared build && pnpm --filter @trailer-arena/client dev",
    "dev:server": "pnpm --filter @trailer-arena/shared build && pnpm --filter @trailer-arena/server dev",
    "build": "pnpm --filter @trailer-arena/shared build && pnpm --filter @trailer-arena/client build && pnpm --filter @trailer-arena/server build",
    "build:client": "pnpm --filter @trailer-arena/shared build && pnpm --filter @trailer-arena/client build",
    "build:server": "pnpm --filter @trailer-arena/shared build && pnpm --filter @trailer-arena/server build",
    "start:server": "pnpm --filter @trailer-arena/server start",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:deployment": "node scripts/verify-deployment.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build:server && pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
